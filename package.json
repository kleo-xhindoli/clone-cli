{
  "name": "onecal-clone-cli",
  "version": "0.1.0",
  "description": "Support CLI that lists and deletes OneCal clone events from Google, Outlook and CalDAV calendars.",
  "private": true,
  "type": "module",
  "bin": {
    "onecal-clone-cli": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "ical.js": "2.0.1",
    "picocolors": "^1.1.1",
    "tsdav": "2.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
